table Metrics
	lineageTag: 13fd210a-3eb9-49a4-bdde-65b532a614b4

	measure Filtered_Rate_Values = ```
			
			VAR SelectedDateRange = VALUES(NBG_Rates[Date])
			VAR SelectedCurrencies = VALUES(NBG_Rates[Currency])
			
			RETURN 
			CALCULATE(
			    SUM(NBG_Rates[Rate]),
			    NBG_Rates[Date] IN SelectedDateRange,
			    NBG_Rates[Currency] IN SelectedCurrencies
			)
			```
		formatString: 0
		lineageTag: c174c936-90eb-498e-904c-bdad40f9143b

	measure Selected_Currency_Info_Title = ```
			
			VAR SelectedCurrency = SELECTEDVALUE(NBG_Rates[Currency])
			VAR CurrencyName = LOOKUPVALUE(Mapping[Currency_Long], Mapping[Currency], SelectedCurrency)
			
			RETURN 
			"1 " & SelectedCurrency & " " & CurrencyName & " : GEL"
			
			```
		displayFolder: For Graph Titles
		lineageTag: 3b77ba31-9fe1-492f-af3c-15c2cff5d70e

	measure %_Rate_Change = ```
			
			VAR CurrentDate = MAX(NBG_Rates[Date])
			VAR PrevDate = 
			    CALCULATE(
			        MAX(NBG_Rates[Date]),
			        FILTER(
			            ALL(NBG_Rates),
			            NBG_Rates[Date] < CurrentDate
			        )
			    )
			VAR CurrentRate = 
			    CALCULATE(
			        AVERAGE(NBG_Rates[Normalized_Rate]),
			        NBG_Rates[Date] = CurrentDate
			    )
			VAR PrevRate = 
			    CALCULATE(
			        AVERAGE(NBG_Rates[Normalized_Rate]),
			        NBG_Rates[Date] = PrevDate
			    )
			
			RETURN 
			DIVIDE(CurrentRate - PrevRate, PrevRate)
			
			
			```
		lineageTag: 55d21e68-e532-4257-8684-68a21091e394

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Latest_Rate = ```
			
			CALCULATE(
			    AVERAGE(NBG_Rates[Rate]),
			    NBG_Rates[Date] = TODAY()
			)
			
			```
		lineageTag: 21efa61e-1659-4be8-9d39-321c3aae2ede

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rate_Change_Daily = ```
			
			VAR TodayDate = TODAY()
			
			VAR PrevDate = 
			    CALCULATE(
			        MAX(NBG_Rates[Date]),
			        FILTER(
			            ALL(NBG_Rates),
			            NBG_Rates[Date] < TodayDate
			        )
			    )
			
			VAR TodayRate = 
			    CALCULATE(
			        AVERAGE(NBG_Rates[Rate]),
			        NBG_Rates[Date] = TodayDate
			    )
			
			VAR PrevRate = 
			    CALCULATE(
			        AVERAGE(NBG_Rates[Rate]),
			        NBG_Rates[Date] = PrevDate
			    )
			
			RETURN 
			TodayRate - PrevRate
			
			```
		lineageTag: a6853ad3-d1fc-486e-ae28-d4f2114fa627

		annotation PBI_FormatHint = {"isGeneralNumber":true}

