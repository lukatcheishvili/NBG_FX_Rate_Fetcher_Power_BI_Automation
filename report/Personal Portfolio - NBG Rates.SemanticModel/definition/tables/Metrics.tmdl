	measure Daily_Change_USD = ```
			
			VAR MaxDate =
			    CALCULATE(
			        MAX(NBG_Rates[Date]),
			        NBG_Rates[Currency] = "USD"
			    )
			VAR PrevDate =
			    CALCULATETABLE(
			        TOPN(1, FILTER(ALL(NBG_Rates), NBG_Rates[Currency] = "USD" && NBG_Rates[Date] < MaxDate), NBG_Rates[Date], DESC)
			    )
			VAR CurrentRate =
			    CALCULATE(
			        AVERAGE(NBG_Rates[Normalized_Rate]),
			        NBG_Rates[Currency] = "USD",
			        NBG_Rates[Date] = MaxDate
			    )
			VAR PrevRate =
			    CALCULATE(
			        AVERAGE(NBG_Rates[Normalized_Rate]),
			        FILTER(PrevDate, NBG_Rates[Currency] = "USD")
			    )
			RETURN
			DIVIDE(CurrentRate - PrevRate, PrevRate)
			
			```
		displayFolder: Latest 5 Currency Rates for Lion Finance Group PLC
		lineageTag: 824b1245-e447-406a-876d-3dc1f2d37583

		annotation PBI_FormatHint = {"isGeneralNumber":true}

