	measure AMD_Change_With_Arrow = ```
			
			VAR Change = [Daily_Change_AMD]
			VAR Arrow = 
			    SWITCH(
			        TRUE(),
			        Change > 0, UNICHAR(9650),   // Up
			        Change < 0, UNICHAR(9660),   // Down
			        UNICHAR(8596)                // Flat
			    )
			RETURN 
			FORMAT(Change, "0.0000%") & " " & Arrow
			
			```
		displayFolder: Latest 5 Currency Rates for Lion Finance Group PLC
		lineageTag: a8757867-678e-4609-b2aa-9020275fa029

