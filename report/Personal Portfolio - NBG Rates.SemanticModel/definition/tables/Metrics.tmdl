	measure Last_Date =
			// Latest rate date in the current date filter, across the selected currencies (so retired ones show blank)
			CALCULATE ( MAX ( NBG_Rates[Date] ), ALLSELECTED ( Mapping ) )
		formatString: dd-MM-yyyy
		displayFolder: NBG Report
		lineageTag: 3fa77646-2499-4c82-8aea-786dfa055592

	measure Window_End = CALCULATE ( MAX ( NBG_Rates[Date] ), ALLSELECTED ( Advanced_Calendar ), ALLSELECTED ( Mapping ) )
		formatString: dd-MM-yyyy
		displayFolder: NBG Report
		lineageTag: 787fae74-d35c-45b6-bca5-fd1ecda4ff4c

	measure Window_Start =
			VAR _end = [Window_End]
			VAR _sliceStart = CALCULATE ( MIN ( Advanced_Calendar[Date] ), ALLSELECTED ( Advanced_Calendar ) )
			VAR _start =
			    SWITCH (
			        SELECTEDVALUE ( Frequency[Period], "ALL" ),
			        "1M", EDATE ( _end, -1 ),
			        "3M", EDATE ( _end, -3 ),
			        "6M", EDATE ( _end, -6 ),
			        "1Y", EDATE ( _end, -12 ),
			        "5Y", EDATE ( _end, -60 ),
			        "YTD", DATE ( YEAR ( _end ), 1, 1 ),
			        _sliceStart
			    )
			RETURN MAX ( _start, _sliceStart )
		formatString: dd-MM-yyyy
		displayFolder: NBG Report
		lineageTag: bd08c26e-7013-45bd-b1cd-14b585519570

	measure Freq_Filter =
			VAR _d = MAX ( Advanced_Calendar[Date] )
			RETURN IF ( _d >= [Window_Start] && _d <= [Window_End], 1, 0 )
		formatString: 0
		displayFolder: NBG Report
		lineageTag: d52e13b6-aac9-4486-8e77-bb360ce30446

	measure Base_Date = "საბაზისო თარიღი " & FORMAT ( [Window_Start], "dd-MM-yyyy" )
		displayFolder: NBG Report
		lineageTag: acf22e87-8a25-4e58-8bd6-b13e2db4beab

	measure Base_Date_Rate =
			// Rate (per K) on the first NBG date of the window, drawn as a flat line
			VAR _start = [Window_Start]
			VAR _baseDate = CALCULATE ( MIN ( NBG_Rates[Date] ), REMOVEFILTERS ( Advanced_Calendar ), NBG_Rates[Date] >= _start )
			RETURN
			    IF (
			        [Freq_Filter] = 1,
			        CALCULATE ( AVERAGE ( NBG_Rates[Rate] ), REMOVEFILTERS ( Advanced_Calendar ), NBG_Rates[Date] = _baseDate )
			    )
		formatString: 0.0000
		displayFolder: NBG Report
		lineageTag: f3fd40ba-c438-4155-97d1-cddfb331d4bf

	measure Growth_R =
			VAR _current = AVERAGE ( NBG_Rates[Rate] )
			VAR _base = [Base_Date_Rate]
			RETURN IF ( NOT ISBLANK ( _current ), DIVIDE ( _current - _base, _base ) )
		formatString: 0%
		displayFolder: NBG Report
		lineageTag: 448afc4f-383e-432a-ba8a-6b63b22ebbf7

	measure Last_Date_Rate =
			// Per 1 unit (USD 2.6005, AMD 0.0072)
			VAR _lastDate = [Last_Date]
			RETURN CALCULATE ( AVERAGE ( NBG_Rates[Normalized_Rate] ), NBG_Rates[Date] = _lastDate )
		formatString: 0.0000
		displayFolder: NBG Report
		lineageTag: 9560fcb0-3507-4193-8569-85e0af9eefe6

	measure Rate_Diff =
			// Change vs the previous weekday: weekend and Monday dates carry the rate NBG set on Friday,
			// so 12/10/2026 (Mon) compares with 09/10/2026 (Fri). Public holidays are not excluded.
			VAR _current = [Last_Date_Rate]
			VAR _prevDate = [Prev_Date]
			VAR _previous = CALCULATE ( AVERAGE ( NBG_Rates[Normalized_Rate] ), REMOVEFILTERS ( Advanced_Calendar ), NBG_Rates[Date] = _prevDate )
			RETURN IF ( NOT ISBLANK ( _current ) && NOT ISBLANK ( _previous ), _current - _previous )
		formatString: 0.0000
		displayFolder: NBG Report
		lineageTag: 2e1473ca-cb31-4ad2-8009-86c9d5c7db94

	measure End_of_Month_ExRate =
			// Per K, on the last date in the month
			VAR _lastDate = MAX ( NBG_Rates[Date] )
			RETURN CALCULATE ( AVERAGE ( NBG_Rates[Rate] ), NBG_Rates[Date] = _lastDate )
		formatString: 0.0000
		displayFolder: NBG Report
		lineageTag: 794b3cf6-c279-47ba-bbfe-e8e7e2242c38

	measure Flag_EOMonth =
			// 0 for the current, unfinished month
			VAR _monthEnd = EOMONTH ( MAX ( Advanced_Calendar[Date] ), 0 )
			VAR _lastDate = CALCULATE ( MAX ( NBG_Rates[Date] ), REMOVEFILTERS ( Advanced_Calendar ), REMOVEFILTERS ( Mapping ) )
			RETURN IF ( _monthEnd <= _lastDate, 1, 0 )
		formatString: 0
		displayFolder: NBG Report
		lineageTag: 0bc0a748-3587-43b0-96bc-45a9716b8b87

	measure Title_Cur_to_Gel =
			SELECTEDVALUE ( Mapping[Division] ) & " " & SELECTEDVALUE ( Mapping[Currency] ) & " "
			    & SELECTEDVALUE ( Mapping[Currency_Long] ) & " : GEL"
		displayFolder: NBG Report
		lineageTag: 398f50b5-1e51-40fd-9212-2df12c809eaf

	measure Title_Ex_Rate = "ოფიციალური გაცვლითი კურსი · " & FORMAT ( [Window_End], "dd-MM-yyyy" )
		displayFolder: NBG Report
		lineageTag: cc8ec0a1-12e7-4275-bb2a-24400bd10ddc

	measure Prev_Date =
			// Previous weekday before Last_Date: weekend and Monday dates carry Friday's rate
			VAR _lastDate = [Last_Date]
			RETURN
			    CALCULATE (
			        MAX ( NBG_Rates[Date] ),
			        REMOVEFILTERS ( Advanced_Calendar ),
			        NBG_Rates[Date] < _lastDate,
			        WEEKDAY ( NBG_Rates[Date], 2 ) <= 5
			    )
		formatString: dd-MM-yyyy
		displayFolder: NBG Report
		lineageTag: 6b1f0d0e-3c4a-4f5e-9a51-2f7c8d9e0a11

	measure Rate_Diff_Label =
			// Arrow + sign so the change never relies on colour alone (KPI cards)
			VAR _d = ROUND ( [Rate_Diff], 4 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Rate_Diff] ), BLANK (),
			        _d > 0, "▲ +" & FORMAT ( _d, "0.0000" ),
			        _d < 0, "▼ −" & FORMAT ( ABS ( _d ), "0.0000" ),
			        "• 0.0000"
			    )
		displayFolder: NBG Report
		lineageTag: 0c2d7a51-8e43-4b6f-a1d2-3e4f5a6b7c80

	measure Compare_Caption = FORMAT ( [Prev_Date], "dd-MM-yyyy" ) & "-თან შედარებით"
		displayFolder: NBG Report
		lineageTag: 9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d

	measure Last_Update_Label = FORMAT ( [Window_End], "dd-MM-yyyy" )
		displayFolder: NBG Report
		lineageTag: 4d3c2b1a-0f9e-4d8c-b7a6-5f4e3d2c1b0a

	measure Weekend_Font_Color =
			// Daily table: weekend rows repeat Friday's rate, so they are dimmed
			IF ( WEEKDAY ( MAX ( Advanced_Calendar[Date] ), 2 ) > 5, "#666666", "#FFFFFF" )
		displayFolder: NBG Report
		lineageTag: 7e6f5a4b-3c2d-4e1f-9a0b-8c7d6e5f4a3b

	measure Weekend_Font_Color_Light =
			// Light-mode twin of Weekend_Font_Color (used by the generated light pages)
			IF ( WEEKDAY ( MAX ( Advanced_Calendar[Date] ), 2 ) > 5, "#8A857C", "#22201C" )
		displayFolder: NBG Report
		lineageTag: 2f4e6a8c-1b3d-4f5a-9c7e-0d2b4f6a8c1e

